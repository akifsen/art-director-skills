{
  "name": "art-director-skills",
  "private": true,
  "description": "Maintainer tooling for the art-director Agent Skill. Not a published npm package and not required to use the skill.",
  "type": "module",
  "scripts": {
    "test": "node tests/run.mjs",
    "test:examples": "node tests/examples/run.mjs",
    "test:examples:build": "node tests/examples/build.mjs",
    "test:e2e": "playwright test",
    "test:install": "node tests/install-cli.mjs",
    "example:kiln": "vite --config evals/apps/kiln-queue/vite.config.js",
    "example:desk": "vite --config evals/apps/nadir-desk/vite.config.js",
    "build:examples": "vite build --config evals/apps/kiln-queue/vite.config.js && vite build --config evals/apps/nadir-desk/vite.config.js",
    "validate": "node tooling/validate-skill.mjs",
    "pack-skill": "node tooling/pack-skill.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.14"
  }
}
