{
  "name": "art-director-skills",
  "private": true,
  "description": "Maintainer tooling for the art-director Agent Skill. Not a published npm package and not required to use the skill.",
  "type": "module",
  "bin": {
    "art-director-skill": "tooling/install-skill.mjs"
  },
  "files": [
    "skills/",
    "tooling/install-skill.mjs",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "install-skill": "node tooling/install-skill.mjs",
    "test": "node tests/run.mjs",
    "test:examples": "node tests/examples/run.mjs",
    "test:examples:build": "node tests/examples/build.mjs",
    "test:e2e": "playwright test --project=flows",
    "test:e2e:seefix": "playwright test --project=seefix",
    "test:e2e:visual": "playwright test --project=visual",
    "test:install": "node tests/install-cli.mjs",
    "example:kiln": "vite --config evals/apps/kiln-queue/vite.config.js",
    "example:desk": "vite --config evals/apps/nadir-desk/vite.config.js",
    "example:rail": "vite --config evals/apps/rail-still/vite.config.js",
    "example:kiln:preview": "node tests/examples/preview.mjs kiln",
    "example:desk:preview": "node tests/examples/preview.mjs desk",
    "example:rail:preview": "node tests/examples/preview.mjs rail",
    "validate": "node tooling/validate-skill.mjs",
    "pack-skill": "node tooling/pack-skill.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.14"
  }
}
