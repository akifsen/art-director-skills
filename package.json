{
  "name": "art-director-skills",
  "version": "0.9.1",
  "description": "Art Director Agent Skill for frontend UI design, plus a zero-dependency CLI that installs it into Claude Code, Cursor, Copilot, Kiro, Codex, Qoder, Roo Code, Gemini CLI, OpenCode, Continue, CodeBuddy, Droid, and Kilo Code.",
  "license": "MIT",
  "author": "akifsen",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akifsen/art-director-skills.git"
  },
  "homepage": "https://github.com/akifsen/art-director-skills#readme",
  "bugs": "https://github.com/akifsen/art-director-skills/issues",
  "keywords": [
    "agent-skill",
    "skills",
    "art-director",
    "ui-design",
    "frontend",
    "cursor",
    "claude-code",
    "codex",
    "copilot"
  ],
  "bin": {
    "art-director": "./bin/cli.js",
    "art-director-skills": "./bin/cli.js",
    "art-director-skill": "./bin/cli.js"
  },
  "files": [
    "bin/",
    "skills/",
    "tooling/install-skill.mjs",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "install-skill": "node bin/cli.js",
    "test": "node tests/run.mjs",
    "test:examples": "node tests/examples/run.mjs",
    "test:examples:build": "node tests/examples/build.mjs",
    "test:e2e": "playwright test --project=flows",
    "test:e2e:seefix": "playwright test --project=seefix",
    "test:e2e:visual": "playwright test --project=visual",
    "test:install": "node tests/install-cli.mjs",
    "example:kiln": "vite --config evals/apps/kiln-queue/vite.config.js",
    "example:desk": "vite --config evals/apps/nadir-desk/vite.config.js",
    "example:rail": "vite --config evals/apps/rail-still/vite.config.js",
    "example:kiln:preview": "node tests/examples/preview.mjs kiln",
    "example:desk:preview": "node tests/examples/preview.mjs desk",
    "example:rail:preview": "node tests/examples/preview.mjs rail",
    "validate": "node tooling/validate-skill.mjs",
    "pack-skill": "node tooling/pack-skill.mjs",
    "prepack": "node tooling/validate-skill.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.14"
  }
}
